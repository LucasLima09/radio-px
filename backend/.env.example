# Copie este arquivo para .env e ajuste os valores quando necessário.
# As variáveis de sessão abaixo já são populadas com defaults seguros
# para desenvolvimento local via docker-compose.

# Segredo usado para assinar os JWT (mínimo 16 caracteres).
JWT_SECRET=dev-only-secret-please-change-32char

# Durações dos tokens.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Servidores STUN (separados por vírgula). TURN ainda não configurado.
STUN_SERVERS=stun:stun.l.google.com:19302