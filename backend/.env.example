# Copie este arquivo para .env e ajuste os valores quando necessário.
# As variáveis de sessão abaixo já são populadas com defaults seguros
# para desenvolvimento local via docker-compose.

# Segredo usado para assinar os JWT (mínimo 16 caracteres).
JWT_SECRET=dev-only-secret-please-change-32char

# Chave pública Ed25519 (base64) que confere a assinatura dos Orbits. O
# simulador (make orbit-sim) mostra a dele ao iniciar.
ORBIT_PUBLIC_KEY=

# Durações dos tokens.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Fila de áudios (cache em memória, sem banco de dados).
# Tempo que um áudio fica disponível para quem entrar no canal.
CLIP_TTL=20m
# Quantidade máxima de áudios mantidos na fila por canal.
CLIP_MAX=200
# Tamanho máximo (em bytes) de um único áudio enviado por um cliente.
CLIP_MAX_BYTES=5242880
# Orçamento total de memória (em bytes) da fila de um canal. Os áudios mais
# antigos são descartados até a fila caber aqui.
CLIP_MAX_QUEUE_BYTES=67108864